NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000

POSTGRES_DB=balancevault
POSTGRES_SHADOW_DB=balancevault_shadow
POSTGRES_USER=balancevault_bootstrap
POSTGRES_PASSWORD=replace_with_a_local_only_password
POSTGRES_APP_PASSWORD=replace_with_a_different_app_password
POSTGRES_MIGRATOR_PASSWORD=replace_with_a_different_migrator_password
DATABASE_URL=postgresql://balancevault_app:replace_with_a_different_app_password@localhost:5432/balancevault?schema=public
DIRECT_URL=postgresql://balancevault_migrator:replace_with_a_different_migrator_password@localhost:5432/balancevault?schema=public
SHADOW_DATABASE_URL=postgresql://balancevault_migrator:replace_with_a_different_migrator_password@localhost:5432/balancevault_shadow?schema=public

REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
JWT_EXPIRES_IN=15m
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Set only for a one-time CLI bootstrap; remove these values immediately afterward.
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_CONFIRM=